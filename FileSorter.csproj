<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>FileSorter</AssemblyName>
    <RootNamespace>FileSorter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CA1416</NoWarn>

    <!-- Exe metadata (visible in File → Properties → Details) -->
    <Product>FileSorter</Product>
    <AssemblyTitle>FileSorter</AssemblyTitle>
    <Company>chupep</Company>
    <Description>Sorts files in a folder into category subfolders by extension or date.</Description>
    <Copyright>Copyright (c) 2026 chupep. MIT License.</Copyright>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- The xUnit test project lives in a subfolder; keep its files out of the main app build. -->
  <ItemGroup>
    <Compile Remove="FileSorter.Tests\**\*" />
    <None Remove="FileSorter.Tests\**\*" />
    <Page Remove="FileSorter.Tests\**\*" />
    <Resource Remove="FileSorter.Tests\**\*" />
    <ApplicationDefinition Remove="FileSorter.Tests\**\*" />
  </ItemGroup>

</Project>
