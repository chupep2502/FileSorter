# Default: auto-detect text files, normalize line endings to LF in repo, CRLF on Windows checkout.
* text=auto

# Force CRLF for Windows-only scripts/configs.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Keep LF for cross-platform configs.
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Source files: let git decide, but text.
*.cs    text
*.xaml  text
*.csproj text
*.sln   text

# Binary — never touched.
*.ico   binary
*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
*.cer   binary
*.pfx   binary
