<Window x:Class="FileSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FileSorter.Services"
        Title="{Binding [AppTitle], Source={x:Static svc:LocalizationService.Current}}"
        Height="640" Width="860"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Glyph style: Segoe Fluent Icons on Win11, MDL2 fallback on Win10. -->
        <Style x:Key="GlyphIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Top bar: title row + theme + language + settings -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="20" FontWeight="SemiBold"
                       Text="{Binding [AppTitle], Source={x:Static svc:LocalizationService.Current}}"/>
            <ComboBox Grid.Column="1" Name="ThemeCombo"
                      Width="120" Margin="0,0,8,0"
                      SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem Tag="system"
                              Content="{Binding [ThemeSystem], Source={x:Static svc:LocalizationService.Current}}"/>
                <ComboBoxItem Tag="light"
                              Content="{Binding [ThemeLight], Source={x:Static svc:LocalizationService.Current}}"/>
                <ComboBoxItem Tag="dark"
                              Content="{Binding [ThemeDark], Source={x:Static svc:LocalizationService.Current}}"/>
            </ComboBox>
            <ComboBox Grid.Column="2" Name="LanguageCombo"
                      Width="100" Margin="0,0,8,0"
                      SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="Русский" Tag="ru"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
            <Button Grid.Column="3" Style="{StaticResource TopBarButton}" Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE713;"/>
                    <TextBlock Text="{Binding [SettingsButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Folder picker row -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,8,0"
                       Text="{Binding [FolderLabel], Source={x:Static svc:LocalizationService.Current}}"/>
            <ComboBox Grid.Column="1" Name="FolderCombo" IsEditable="True" Padding="6,4"/>
            <Button   Grid.Column="2" Name="BrowseButton" Style="{StaticResource TopBarButton}"
                      Click="BrowseButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8DA;"/>
                    <TextBlock Text="{Binding [BrowseButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Options row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,12">
            <CheckBox Name="RecursiveCheck"
                      Content="{Binding [RecursiveCheckbox], Source={x:Static svc:LocalizationService.Current}}"/>
        </StackPanel>

        <!-- Action buttons + status -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="StatusText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding [Ready], Source={x:Static svc:LocalizationService.Current}}"/>
            <Button Grid.Column="1" Name="UndoButton" Style="{StaticResource TopBarButton}"
                    Click="UndoButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE7A7;"/>
                    <TextBlock Text="{Binding [UndoButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Name="PreviewButton" Style="{StaticResource TopBarButton}"
                    Click="PreviewButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8FF;"/>
                    <TextBlock Text="{Binding [PreviewButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Name="SortButton"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="92" Padding="14,7" Margin="4,0,0,0"
                    Click="SortButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B5;"/>
                    <TextBlock Text="{Binding [SortButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Name="CancelButton" IsEnabled="False"
                    Style="{StaticResource TopBarButton}"
                    Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE711;"/>
                    <TextBlock Text="{Binding [CancelButton], Source={x:Static svc:LocalizationService.Current}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress bar + count -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Name="ProgressRow" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Name="ProgressBar" Height="6" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock   Grid.Column="1" Name="ProgressText" Margin="10,0,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>

        <!-- Bottom status bar: version on the right -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="StatusBarLeft"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Name="VersionText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11"/>
        </Grid>

        <!-- Log header + filter -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold"
                       Text="{Binding [LogHeader], Source={x:Static svc:LocalizationService.Current}}"/>
            <TextBox   Grid.Column="1" Name="LogFilterBox" Margin="12,0,0,0" Padding="6,4"
                       Tag="{Binding [LogFilterPlaceholder], Source={x:Static svc:LocalizationService.Current}}"
                       TextChanged="LogFilterBox_TextChanged"/>
        </Grid>

        <!-- Log list -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}" Margin="0,4,0,0">
            <ListBox Name="LogList" BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Cascadia Mono, monospace"
                     MouseDoubleClick="LogList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
