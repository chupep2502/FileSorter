<Application x:Class="FileSorter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light theme baked in by default; ThemeService swaps it at startup
                     with the actual mode (system/light/dark) and keeps it in sync. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
