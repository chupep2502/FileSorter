<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush"            Color="#FAFAFA"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TextDimBrush"       Color="#888888"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#2D7DD2"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>

    <!-- Borders / separators -->
    <SolidColorBrush x:Key="BorderBrush"        Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#E5E5E5"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackgroundHoverBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ButtonBorderBrush"          Color="#C8C8C8"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush"     Color="#C8C8C8"/>

    <!-- Log row colors -->
    <SolidColorBrush x:Key="LogMoveBrush"  Color="#186A3E"/>
    <SolidColorBrush x:Key="LogSkipBrush"  Color="#707070"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#B02121"/>
    <SolidColorBrush x:Key="LogInfoBrush"  Color="#1B1B1B"/>

</ResourceDictionary>
