<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#2A2A2A"/>
    <SolidColorBrush x:Key="PanelBrush"            Color="#252525"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="TextDimBrush"       Color="#888888"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush"           Color="#3A8FE0"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>

    <!-- Borders / separators -->
    <SolidColorBrush x:Key="BorderBrush"       Color="#3D3D3D"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush"      Color="#333333"/>
    <SolidColorBrush x:Key="ButtonBackgroundHoverBrush" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="ButtonBorderBrush"          Color="#4A4A4A"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="InputBorderBrush"     Color="#4A4A4A"/>

    <!-- Log row colors (a bit brighter so they pop on dark bg) -->
    <SolidColorBrush x:Key="LogMoveBrush"  Color="#5DD08A"/>
    <SolidColorBrush x:Key="LogSkipBrush"  Color="#9A9A9A"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF6E6E"/>
    <SolidColorBrush x:Key="LogInfoBrush"  Color="#F0F0F0"/>

</ResourceDictionary>
